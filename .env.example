# ── Used by the demo today ────────────────────────────────────────────
# Optional. Without it the agent runs in simulated mode (rule-based, no LLM, zero cost).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Any Gemini model that supports function calling.
GEMINI_MODEL=gemini-flash-latest
# Optional. If set, visitors must enter this code before chatting.
DEMO_ACCESS_CODE=
# Optional. Protects /api/cron/daily-digest (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ── Reserved for the planned integrations (not read by the demo) ──────
# Google Sheets as the data source
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Email delivery for quotes and the daily digest
EMAIL_PROVIDER=            # gmail | resend
EMAIL_FROM=
RESEND_API_KEY=
GMAIL_APP_PASSWORD=
# Gmail inbox + Google Calendar (OAuth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Firebase (auth, roles, Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# WhatsApp Business Cloud API (field technicians)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
